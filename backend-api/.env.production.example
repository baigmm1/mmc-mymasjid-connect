# Azure App Service Environment Variables
# Copy these settings to Azure Portal → App Service → Configuration → Application settings

# ============================================================================
# CRITICAL: Application Environment
# ============================================================================
ENVIRONMENT=production
DEBUG=false

# ============================================================================
# Database Configuration (Azure SQL with Managed Identity)
# ============================================================================
# SQL Server hostname (without protocol)
DB_SERVER=your-server-name.database.windows.net
DB_NAME=masjiddb

# Optional: User-assigned managed identity client ID
# Leave empty to use system-assigned managed identity
DB_IDENTITY_CLIENT_ID=

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=30
DB_ECHO_SQL=false

# ============================================================================
# API Configuration
# ============================================================================
API_TITLE=Masjid Connect API
API_VERSION=1.0.0
API_DESCRIPTION=Masjid Connect API Service - Production

# ============================================================================
# Server Configuration
# ============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
TIMEOUT=600

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# CORS Configuration
# ============================================================================
# Update with your frontend domain
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# Azure App Service Specific Settings
# ============================================================================
# ORYX Build Configuration
SCM_DO_BUILD_DURING_DEPLOYMENT=true
WEBSITE_RUN_FROM_PACKAGE=0
ENABLE_ORYX_BUILD=true

# Python Configuration
PYTHON_VERSION=3.11

# Logging
WEBSITE_HTTPLOGGING_RETENTION_DAYS=7

# ============================================================================
# Optional: Application Insights (for monitoring)
# ============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxxx;IngestionEndpoint=https://...

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 1. Configure these in Azure Portal, NOT in a .env file
# 2. Restart App Service after changing environment variables
# 3. Verify with: curl https://your-app.azurewebsites.net/
# 4. Check health: curl https://your-app.azurewebsites.net/health
# 5. Check database: curl https://your-app.azurewebsites.net/health/db
